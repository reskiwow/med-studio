generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled, used at runtime
  directUrl = env("DIRECT_URL")     // non-pooled, used by `prisma migrate`
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Owner status is NEVER stored as a boolean flag on the user record.
  // It is derived server-side on every request from OWNER_DISCORD_IDS
  // (see src/lib/auth.ts). This avoids a stale/forged "isOwner" column.

  discordAccount    DiscordAccount?
  robloxConnections RobloxConnection[]
  audioJobs         AudioJob[]
  uploadHistory     UploadHistory[]
  dailyUsage        DailyUsage[]
  vipSubscription   VipSubscription?
  sessions          Session[]
}

model DiscordAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  discordId     String   @unique // stable Discord snowflake, used for auth + OWNER_DISCORD_IDS check
  username      String
  discriminator String?
  avatarHash    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discordId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // hash of the session token; raw token never stored
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipHash    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Roblox integration
// ---------------------------------------------------------------------------

enum RobloxTargetType {
  CREATOR
  GROUP
}

model RobloxConnection {
  id         String           @id @default(cuid())
  userId     String
  targetType RobloxTargetType

  // Creator mode
  robloxUserId String?

  // Group mode
  robloxGroupId String?

  // Credential is encrypted at rest (see src/lib/crypto.ts) and only ever
  // decrypted server-side, immediately before a documented Roblox API call.
  // The API only ever returns a masked form (e.g. "sk_live_••••1234").
  encryptedCredential String
  credentialLast4     String

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  audioJobs AudioJob[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Audio processing + publishing
// ---------------------------------------------------------------------------

enum JobStatus {
  PREPARING
  PROCESSING
  UPLOADING
  ROBLOX_RESPONSE
  COMPLETED
  FAILED
}

enum RobloxResultStatus {
  PENDING       // Roblox has not returned a final moderation result yet
  SUCCESS
  PROCESSING    // Roblox itself reports the asset is still moderating
  REJECTED
  FAILED
}

model AudioFile {
  id               String   @id @default(cuid())
  originalFilename String
  storageKey       String   // path/key in object storage, not a public URL
  mimeType         String
  sizeBytes        Int
  durationSeconds  Float?
  createdAt        DateTime @default(now())

  originalForJob AudioJob? @relation("OriginalFile")
  processedForJob AudioJob? @relation("ProcessedFile")
}

model AudioJob {
  id     String @id @default(cuid())
  userId String

  robloxConnectionId String?
  robloxConnection    RobloxConnection? @relation(fields: [robloxConnectionId], references: [id])

  originalFileId  String    @unique
  originalFile    AudioFile @relation("OriginalFile", fields: [originalFileId], references: [id])
  processedFileId String?   @unique
  processedFile   AudioFile? @relation("ProcessedFile", fields: [processedFileId], references: [id])

  // Processing settings actually applied to this job
  speed           Float  @default(2.3)
  amplifyDb       Float  @default(-4)
  maxDurationSecs Int    @default(350)

  status          JobStatus @default(PREPARING)
  errorMessage    String?

  // Roblox's own reported result. Never fabricated client- or server-side;
  // this field is only ever set from an actual Roblox API response.
  robloxAssetId      String?
  robloxOperationPath String? // Open Cloud long-running Operation path, used to poll for a final result
  robloxResult       RobloxResultStatus @default(PENDING)
  robloxRawResponse  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploadHistory UploadHistory?

  @@index([userId, createdAt])
}

model UploadHistory {
  id    String @id @default(cuid())
  jobId String @unique
  job   AudioJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  userId      String
  destination RobloxTargetType
  filename    String
  duration    Float?
  status      JobStatus
  robloxResult RobloxResultStatus
  errorMessage String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Usage limiting
// ---------------------------------------------------------------------------

model DailyUsage {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime // truncated to the day (UTC midnight) this row represents
  usageCount Int      @default(0)
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ---------------------------------------------------------------------------
// VIP
// ---------------------------------------------------------------------------

model VipSubscription {
  id     String @id @default(cuid())
  userId String @unique

  isActive Boolean   @default(false)
  // null dailyLimit = unlimited for this VIP; otherwise a custom quota
  dailyLimit Int?
  expiresAt  DateTime?

  activatedByOwnerId String? // Discord ID of the owner who activated this
  createdAt           DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Owner audit trail
// ---------------------------------------------------------------------------

model OwnerLog {
  id             String   @id @default(cuid())
  ownerDiscordId String
  action         String   // e.g. "VIP_ACTIVATE", "USAGE_RESET", "VIP_DEACTIVATE"
  targetUserId   String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([ownerDiscordId, createdAt])
}
