# --- Database (Neon, or any Postgres provider) ---
# Pooled: used by the app at runtime (Neon: hostname has -pooler)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct: used only by `prisma migrate` (Neon: same hostname without -pooler)
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Discord OAuth2 ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# --- Owner access (comma-separated Discord user IDs) ---
OWNER_DISCORD_IDS=

# --- Sessions ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- Roblox (Open Cloud) ---
# Fill in only with credentials you legitimately own. Never commit real values.
# See src/lib/roblox/README.md for what is/isn't implemented.
ROBLOX_API_BASE_URL=https://apis.roblox.com

# --- WhatsApp VIP contact ---
VIP_WHATSAPP_NUMBER=6282197014242
